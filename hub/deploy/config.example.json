{
  "name": "Helios Hub",
  "serial": "auto",
  "display": "hdmi",
  "hdmi": {
    "dev": "/dev/fb0",
    "fps": 30,
    "width": 1280,
    "height": 720,
    "mode": "1280x720@60",
    "force_mode": false
  },
  "tft": {
    "width": 160,
    "height": 128,
    "rotate": 1,
    "spi_bus": 0,
    "spi_device": 0,
    "dc": 25,
    "rst": 24,
    "speed_hz": 16000000,
    "bgr": true,
    "invert": false,
    "col_offset": 0,
    "row_offset": 0
  },
  "oled": {
    "driver": "ssd1306",
    "width": 128,
    "height": 64,
    "address": "0x3C",
    "i2c_port": 1,
    "rotate": 0
  },
  "joystick": {
    "swap_xy": false,
    "invert_x": false,
    "invert_y": false
  },
  "host": "0.0.0.0",
  "port": 8765,
  "db": "/var/lib/crewhub/hub.db",
  "token_file": "/var/lib/crewhub/token",
  "home_after_s": 180,
  "sleep_after_s": 1800,
  "sensors": {},
  "public_url": "https://nasa.softhoarders.me",
  "vapid_key": "/var/lib/crewhub/vapid.pem"
}
