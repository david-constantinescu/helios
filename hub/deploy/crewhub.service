[Unit]
Description=Helios (Uno sensors, OLED, app server)
After=network.target

[Service]
User=@USER@
Group=@USER@
SupplementaryGroups=dialout i2c spi gpio video
WorkingDirectory=/opt/crewhub/app
ExecStart=/opt/crewhub/venv/bin/python -m crewhub --config /etc/crewhub/config.json
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
